@model IEnumerable<personapi_dotnet.Models.Entities.Estudios>
@{
    ViewData["Title"] = "Estudios";
}
<h1>Estudios</h1>
<p><a class="btn btn-primary" asp-action="Create">Nuevo estudio</a></p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(m => m.IdProf)</th>
            <th>@Html.DisplayNameFor(m => m.CcPer)</th>
            <th>@Html.DisplayNameFor(m => m.Fecha)</th>
            <th>@Html.DisplayNameFor(m => m.Univer)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.IdProf</td>
                <td>@item.CcPer</td>
                <td>@(item.Fecha?.ToString("yyyy-MM-dd"))</td>
                <td>@item.Univer</td>
                <td>
                    <a class="btn btn-sm btn-info"    asp-action="Details" asp-route-idProf="@item.IdProf" asp-route-ccPer="@item.CcPer">Detalle</a>
                    <a class="btn btn-sm btn-warning" asp-action="Edit"    asp-route-idProf="@item.IdProf" asp-route-ccPer="@item.CcPer">Editar</a>
                    <a class="btn btn-sm btn-danger"  asp-action="Delete"  asp-route-idProf="@item.IdProf" asp-route-ccPer="@item.CcPer">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
