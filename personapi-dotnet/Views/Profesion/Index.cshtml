@model IEnumerable<personapi_dotnet.Models.Entities.Profesion>
@{
    ViewData["Title"] = "Profesiones";
}
<h1>Profesiones</h1>
<p><a class="btn btn-primary" asp-action="Create">Nueva profesión</a></p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(m => m.Id)</th>
            <th>@Html.DisplayNameFor(m => m.Nom)</th>
            <th>@Html.DisplayNameFor(m => m.Des)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Nom</td>
                <td>@item.Des</td>
                <td>
                    <a class="btn btn-sm btn-info"    asp-action="Details" asp-route-id="@item.Id">Detalle</a>
                    <a class="btn btn-sm btn-warning" asp-action="Edit"    asp-route-id="@item.Id">Editar</a>
                    <a class="btn btn-sm btn-danger"  asp-action="Delete"  asp-route-id="@item.Id">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
