@model IEnumerable<personapi_dotnet.Models.Entities.Persona>
@{
    ViewData["Title"] = "Personas";
}
<h1>Personas</h1>
<p><a class="btn btn-primary" asp-action="Create">Nueva persona</a></p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(m => m.Cc)</th>
            <th>@Html.DisplayNameFor(m => m.Nombre)</th>
            <th>@Html.DisplayNameFor(m => m.Apellido)</th>
            <th>@Html.DisplayNameFor(m => m.Genero)</th>
            <th>@Html.DisplayNameFor(m => m.Edad)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Cc</td>
                <td>@item.Nombre</td>
                <td>@item.Apellido</td>
                <td>@item.Genero</td>
                <td>@item.Edad</td>
                <td>
                    <a class="btn btn-sm btn-info"    asp-action="Details" asp-route-id="@item.Cc">Detalle</a>
                    <a class="btn btn-sm btn-warning" asp-action="Edit"    asp-route-id="@item.Cc">Editar</a>
                    <a class="btn btn-sm btn-danger"  asp-action="Delete"  asp-route-id="@item.Cc">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
