<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PersonaAPI</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-md navbar-dark bg-dark mb-3">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">PersonaAPI</a>
                <div class="collapse navbar-collapse">
                    <ul class="navbar-nav">
                        <li class="nav-item"><a class="nav-link" asp-controller="Persona"   asp-action="Index">Personas</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Profesion" asp-action="Index">Profesiones</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Estudios"  asp-action="Index">Estudios</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Telefono"  asp-action="Index">Teléfonos</a></li>
                        <li class="nav-item"><a class="nav-link" href="/swagger" target="_blank">Swagger</a></li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top text-muted py-3 mt-4">
        <div class="container">&copy; @DateTime.Now.Year - personapi-dotnet</div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
