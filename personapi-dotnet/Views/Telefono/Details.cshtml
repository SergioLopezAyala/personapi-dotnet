@model personapi_dotnet.Models.Entities.Telefono
@{
    ViewData["Title"] = "Detalle teléfono";
}
<h1>Detalle teléfono</h1>
<hr />
<dl class="row">
    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Num)</dt>    <dd class="col-sm-9">@Model.Num</dd>
    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Oper)</dt>   <dd class="col-sm-9">@Model.Oper</dd>
    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Duenio)</dt> <dd class="col-sm-9">@Model.Duenio</dd>
</dl>
<a class="btn btn-warning" asp-action="Edit" asp-route-id="@Model.Num">Editar</a>
<a class="btn btn-secondary" asp-action="Index">Volver</a>
