@model personapi_dotnet.Models.Entities.Telefono
@{
    ViewData["Title"] = "Eliminar teléfono";
}
<h1>Eliminar teléfono</h1>
<div class="alert alert-warning">¿Confirma eliminar este registro?</div>
<dl class="row">
    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Num)</dt>    <dd class="col-sm-9">@Model.Num</dd>
    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Oper)</dt>   <dd class="col-sm-9">@Model.Oper</dd>
    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Duenio)</dt> <dd class="col-sm-9">@Model.Duenio</dd>
</dl>
<form asp-action="Delete" method="post">
    <input type="hidden" name="id" value="@Model.Num" />
    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a class="btn btn-secondary" asp-action="Index">Cancelar</a>
</form>
